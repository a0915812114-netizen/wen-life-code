rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email in [
          'a0915812114@gmail.com'
        ];
    }

    function validLogCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'name', 'dob', 'mainChar', 'createdAt', 'dedupeKey'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 40
        && d.dob is string
        && d.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.mainChar is int
        && d.mainChar >= 1
        && d.mainChar <= 9
        && d.createdAt is int
        && d.dedupeKey is string
        && d.dedupeKey.size() > 0
        && d.dedupeKey.size() <= 120
        && (!('archetype' in d) || (d.archetype is string && d.archetype.size() <= 20))
        && (!('ideology' in d) || (d.ideology is string && d.ideology.size() <= 20))
        && (!('outerChar' in d) || (d.outerChar is string && d.outerChar.size() <= 12))
        && (!('innerChar' in d) || (d.innerChar is string && d.innerChar.size() <= 12))
        && (!('guardingCode' in d) || (d.guardingCode is string && d.guardingCode.size() <= 12))
        && (!('careerCode' in d) || (d.careerCode is string && d.careerCode.size() <= 12))
        && (!('outerHeartType' in d) || (d.outerHeartType is string && d.outerHeartType.size() <= 20))
        && (!('motivation' in d) || (d.motivation is int && d.motivation >= 1 && d.motivation <= 9))
        && (!('energy' in d) || (d.energy is int && d.energy >= 1 && d.energy <= 9));
    }

    function validLogUpdate() {
      let d = request.resource.data;
      let r = resource.data;
      return validLogCreate()
        && d.dedupeKey == r.dedupeKey
        && d.name == r.name
        && d.dob == r.dob
        && d.mainChar == r.mainChar;
    }

    match /artifacts/{appId}/public/data/analysis_logs/{docId} {
      allow create: if validLogCreate();
      allow update: if validLogUpdate();
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
